package primeiroProjeto;

public class Lista20 {

	public static void main(String[] args) {
		contagem("Bom dia!",5);
		linha();
		contagem("*****",3);
		
		
	}
	
	
	public static void linha() {
		System.out.println("-----------------");
	}
	
	
	public static void contagem(String frase, int vezes) {
        for (int i = 1; i <= vezes; i++) {
            System.out.println(frase);
        }
	}
}
